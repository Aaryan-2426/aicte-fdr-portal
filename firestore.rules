rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // FDR Record Validator
    function isValidFDR(data) {
      return data.fdrNumber is string && data.fdrNumber.size() > 0 && data.fdrNumber.size() <= 100
        && data.fdrAmount is number && data.fdrAmount >= 0
        && data.bankName is string && data.bankName.size() <= 100
        && data.instituteName is string && data.instituteName.size() <= 200;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // FDR Records Collection
    match /fdrRecords/{fdrId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(fdrId)
        && isValidFDR(incoming());
      allow update: if isSignedIn()
        && isValidId(fdrId)
        && isValidFDR(incoming());
      allow delete: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(notificationId);
      allow delete: if isSignedIn();
    }
  }
}
